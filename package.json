{
  "name": "norless",
  "version": "0.0.0",
  "private": true,
  "description": "Song projection for communities that project several languages in sync",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "i18n": "i18next-cli lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "specs": "openspec validate --all --strict --no-interactive",
    "dev:server": "tsx watch src/server/index.ts",
    "converter": "docker build -q -t norless-converter src/converter && (docker rm -f norless-converter-${CONVERTER_PORT:-3900} >/dev/null 2>&1; docker run --rm --name norless-converter-${CONVERTER_PORT:-3900} --read-only --tmpfs /tmp:size=1g -p 127.0.0.1:${CONVERTER_PORT:-3900}:3900 norless-converter)",
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "videos": "playwright test -c playwright.videos.config.ts",
    "check": "npm run lint && npm run i18n && npm run format:check && npm run typecheck && npm run specs && npm test",
    "import": "tsx src/server/import/cli.ts",
    "invite": "tsx src/server/cli/invite.ts",
    "backup": "tsx src/server/cli/backup.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "better-sqlite3": "13.0.3",
    "bson": "7.3.3",
    "diff": "9.0.0",
    "fastify": "5.12.5",
    "ical.js": "2.2.1",
    "jose": "6.2.12",
    "openid-client": "6.8.8",
    "tonal": "6.4.3",
    "web-push": "3.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.14.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@playwright/test": "1.63.0",
    "@react-aria/optimize-locales-plugin": "2.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "abcjs": "6.7.1",
    "d3-hierarchy": "3.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "i18next": "26.4.2",
    "i18next-cli": "1.74.4",
    "lean-qr": "2.7.4",
    "lucide-react": "1.51.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "realtime-bpm-analyzer": "5.0.15",
    "svguitar": "2.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "wouter": "3.13.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "better-sqlite3": false
  }
}
