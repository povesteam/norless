# Copy to .env (git-ignored) for run-dev.sh and run-reimport.sh.
# The local database.
DATABASE_PATH=/path/to/norless.db
# Where the old app runs, for run-reimport.sh to take a fresh backup.
PROD_SSH=root@app.norless.com
# Who becomes owner again after run-reimport.sh.
OWNER_EMAIL=you@example.com
# Locally, a slow network: API answers and live updates wait 300-1500 ms.
#SLOW=1
# Locally, a bad network: about 1 in 10 API calls fail, live connections drop now and then.
#FLAKY=1
# The Norless app team, who get the ideas sent to them (comma-separated).
#APP_TEAM_EMAILS=you@example.com
